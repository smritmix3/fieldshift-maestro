# Copy this file to ".env" (same folder) and fill in your keys. ".env" is gitignored.
# Never paste keys into chat, code, README or commits.

# Required for the GenAI advisor (free key: https://aistudio.google.com -> "Get API key")
GEMINI_API_KEY=

# Optional fallback provider (free models: https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Optional overrides. Leave blank to auto-detect available free models.
GEMINI_MODEL_PRIMARY=
GEMINI_MODEL_SECONDARY=
OPENROUTER_MODEL=

# Conservative local rate budgets (requests per minute / per day). Free-tier limits change; verify at aistudio.google.com.
GEMINI_PRIMARY_RPM=8
GEMINI_PRIMARY_DAILY=200
GEMINI_SECONDARY_RPM=12
GEMINI_SECONDARY_DAILY=800
OPENROUTER_RPM=10
OPENROUTER_DAILY=40

# Optional: live Indian mandi prices for chickpea, mung, mustard, bajra, groundnut and others (free key: https://data.gov.in -> register -> My Account)
DATA_GOV_IN_API_KEY=
